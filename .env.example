# ============================================================
# AI Accessible Communication Assistant — Environment Template
# Copy to `backend/.env` and fill in real values.
# NEVER commit the real .env file. Frontend code never sees
# any of these — all provider calls happen through the backend.
# ============================================================

# --- Server ---
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Provider selection ---
STT_PROVIDER=openai
TTS_PROVIDER=piper
TRANSLATION_PROVIDER=google
AI_PROVIDER=openai

# --- OpenAI (used by STT, TTS, and AI providers) ---
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_AI_MODEL=gpt-4o-mini

# --- Local Piper TTS ---
# Path to Piper CLI (if on PATH, just "piper")
PIPER_EXECUTABLE=piper
# Path to local Piper model directory (place model files under backend/models/piper/...)
PIPER_MODEL_PATH=models/piper/en_US-lessac-medium
PIPER_VOICE=en_US-lessac-medium

# --- Google Cloud Translation (API v2, simple API key) ---
GOOGLE_TRANSLATE_API_KEY=

# --- WebRTC / TURN ---
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Frontend (Vite reads VITE_-prefixed vars at build time) ---
VITE_BACKEND_URL=http://localhost:8000
VITE_STUN_URLS=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
